<view style="padding-top:{{top}}px" class="head"><view class="bar" style="height:{{height}}px;padding-right:{{right}}px"><view wx:if="{{back}}" class="back" bindtap="goBack" hover-class="back-pressed" role="button" aria-label="返回上一页"><view class="back-glyph"><ui-icon name="arrow-left" size="20" unit="px"/></view></view><view wx:else class="brand-mark"><ui-icon name="file" size="14" unit="px" weight="1.9"/></view><text class="title">{{title}}</text><text wx:if="{{!back}}" class="tagline">选模板，写简历</text></view></view>
