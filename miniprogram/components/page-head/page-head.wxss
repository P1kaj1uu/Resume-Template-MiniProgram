.head{background:#f6f7f2;color:#2c3a31}.bar{display:flex;align-items:center;padding-left:36rpx;gap:0;box-sizing:border-box}.title{font-size:15px;font-weight:600;letter-spacing:1rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}.tagline{font-size:10px;margin-left:18rpx;color:#8d978b;white-space:nowrap;flex-shrink:1;overflow:hidden;text-overflow:ellipsis}.brand-mark{width:21px;height:23px;border-radius:11rpx;background:#315d4d;color:#f5f8ef;display:flex;align-items:center;justify-content:center;margin-right:14rpx;flex-shrink:0}.back{width:44px;height:44px;display:flex;align-items:center;justify-content:center;margin-left:-17rpx;margin-right:7rpx;flex-shrink:0}.back-glyph{width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:#fff;border:1rpx solid #e3e8df;border-radius:50%;color:#365846;box-shadow:0 3rpx 8rpx #263b2d04;transition:transform 120ms cubic-bezier(.2,0,0,1),background-color 120ms cubic-bezier(.2,0,0,1)}.back-glyph ui-icon{transform:translateX(-1rpx)}.back-pressed .back-glyph{transform:scale(.96);background:#e7eee5}@media(prefers-reduced-motion:reduce){.back-glyph{transition:none}.back-pressed .back-glyph{transform:none}}
