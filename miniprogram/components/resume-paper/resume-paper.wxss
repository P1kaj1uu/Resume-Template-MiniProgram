:host{display:block;height:100%}.paper{box-sizing:border-box;min-height:100%;background:#fff;color:#344139;padding:8%;position:relative;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;border-top:8rpx solid var(--accent)}.paper-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;position:relative}.name{font-size:40rpx;line-height:1.4;letter-spacing:5rpx;font-weight:650;color:var(--accent);overflow-wrap:anywhere}.role{font-size:18rpx;color:#6c7c70;margin-top:9rpx}.monogram{font-size:12rpx;letter-spacing:4rpx;writing-mode:vertical-rl;border-left:1rpx solid #dfe5da;padding-left:14rpx;color:#95a18f;flex-shrink:0}.contact{display:flex;flex-wrap:wrap;gap:6rpx 18rpx;font-size:13rpx;color:#899185;margin:22rpx 0 7rpx;overflow-wrap:anywhere}.paper-body{display:block}.main-column{min-width:0;flex:1}.paper-bottom{height:28rpx}.header-dark{background:var(--accent);margin:-9.6% -9.6% 0;padding:8% 9.6%}.header-dark .name,.header-dark .role,.header-dark .monogram{color:white}.header-dark .monogram{border-color:#ffffff40}.campus{border:0}.header-center{justify-content:center;text-align:center}.header-center .name{letter-spacing:9rpx}.header-center .monogram{display:none}.minimal,.centered{border:0}.minimal .contact,.centered .contact{justify-content:center}.creative{border-top:0;border-left:22rpx solid var(--accent);padding-left:7%}.header-editorial .name{font-family:"Songti SC","SimSun",serif;font-size:49rpx;letter-spacing:7rpx}.header-editorial{border-bottom:3rpx solid var(--accent);padding-bottom:21rpx}.header-bordered{border:2rpx solid var(--accent);padding:23rpx 20rpx}.outline{border:0}.has-columns .paper-body{display:flex;gap:25rpx;align-items:stretch}.side-column{flex:0 0 31%;width:31%;background:var(--tint);padding:0 15rpx 25rpx;min-width:0}.columns-right{flex-direction:row-reverse}.columns-right .side-column{background:transparent;border-left:1rpx solid #dce2d8;padding-left:20rpx;padding-right:0}.columns-equal .side-column{flex:0