.section{padding-top:23rpx;color:#3c4541;font-family:inherit}.heading{display:flex;align-items:center;gap:12rpx;font-size:var(--heading-size,21rpx);font-weight:650;color:var(--accent);padding-bottom:8rpx;margin-bottom:14rpx;border-bottom:1rpx solid #dce1db;line-height:1.5}.heading-stroke{display:none}.entry{margin-bottom:17rpx}.entry:last-child{margin-bottom:0}.entry-top{display:flex;justify-content:space-between;align-items:baseline;gap:10rpx;flex-wrap:wrap}.primary{font-size:var(--entry-size,18rpx);font-weight:650;flex-shrink:1}.period{font-size:13rpx;color:#899087}.secondary{font-size:var(--body-size,16rpx);color:#68756d;margin:5rpx 0 7rpx}.body{font-size:var(--body-size,16rpx);line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere;color:#69736c}.heading-fill .heading{border:0;background:var(--tint);padding:6rpx 10rpx}.heading-bar .heading{border-bottom:0;border-left:5rpx solid var(--accent);padding:0 0 0 10rpx}.heading-rule .heading{border-bottom:2rpx solid var(--accent)}.heading-frame .heading{border:1rpx solid #d1d9d0;padding:6rpx 10rpx}.heading-number .heading{border:0;align-items:baseline}.section-number{font-size:23rpx;font-weight:400;opacity:.48}.heading-dot{border-left:1rpx solid #d2dbd1;padding-left:18rpx;position:relative}.heading-dot .heading{border:0;position:relative}.heading-dot .heading:before{content:'';position:absolute;left:-24rpx;top:10rpx;width:9rpx;height:9rpx;border-radius:50%;background:var(--accent)}.heading-box{border:1rpx solid #d9e0d6;padding:16rpx;margin-top:18rpx}.heading-box .heading{border:0;margin-bottom:8rpx;padding-bottom:0}.heading-pill .heading{border:0;justify-content:center;gap:0}.heading-pill .heading>text{background:var(--tint);padding:4rpx 23rpx;border-radius:25rpx}.heading-split .heading{border:0;gap:14rpx}.heading-split .heading-stroke{display:block;flex:1;height:1rpx;background:#d4dcd1}.compact{padding-top:16rpx}.compact .body{font-size:calc(var(--body-size,16rpx) * .94);line-height:1.65}.compact .entry{margin-bottom:12rpx}.compact .heading{margin-bottom:10rpx;font-size:calc(var(--heading-size,21rpx) * .91)}.relaxed{padding-top:28rpx}.relaxed .body{line-height:2}.editorial .heading,.serif .heading{font-family:"Songti SC","SimSun",serif}.ledger .entry-top{padding-bottom:5rpx;border-bottom:1rpx dotted #dde2d9}.compact.heading-box{margin-top:13rpx;padding:13rpx}
.heading-double .heading{border-bottom:4rpx double var(--accent)}.heading-dash .heading{border-bottom:1rpx dashed #bdcbb3}.heading-tab .heading{border:0;background:var(--tint);padding:6rpx 12rpx;max-width:75%}.heading-letter .heading{border:0;border-top:1rpx solid #cbd7c2;padding-top:9rpx}.heading-margin{position:relative;padding-left:100rpx;min-height:90rpx}.heading-margin .heading{position:absolute;left:0;top:23rpx;max-width:82rpx;border:0;font-size:18rpx;line-height:1.8}.secondary{overflow-wrap:anywhere;word-break:break-all}
.link-secondary{color:#628a87;text-decoration:underline;text-underline-offset:3rpx}


