.tab-bar{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1rpx solid #e9ede5;padding:13rpx 24rpx calc(13rpx + env(safe-area-inset-bottom));z-index:50;box-shadow:0 -5rpx 24rpx #2b413004}.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#879187;position:relative;font-size:10px;gap:5rpx;min-height:43px}.tab-icon-box{display:flex;align-items:center;justify-content:center;width:40px;height:28px;border-radius:17rpx;transition:background-color 120ms cubic-bezier(.2,0,0,1),transform 120ms cubic-bezier(.2,0,0,1)}.selected{color:#315d4d;font-weight:600}.selected .tab-icon-box{background:#e9f0e7}.tab-pressed .tab-icon-box{transform:scale(.96);background:#edf2ea}@media(prefers-reduced-motion:reduce){.tab-icon-box{transition:none}.tab-pressed .tab-icon-box{transform:none}}
