<view class="tab-bar"><view wx:for="{{tabs}}" wx:key="path" class="tab {{selected===index?'selected':''}}" data-index="{{index}}" bindtap="switchTab" hover-class="tab-pressed" role="button" aria-label="{{item.name}}" aria-current="{{selected===index?'page':'false'}}"><view class="tab-icon-box"><ui-icon name="{{item.icon}}" size="20" unit="px" filled="{{selected===index}}"/></view><text>{{item.name}}</text></view></view>
