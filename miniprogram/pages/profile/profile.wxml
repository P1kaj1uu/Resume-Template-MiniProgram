<page-head/>
<view class="page tab-page profile-page">
 <view wx:if="{{loadError}}" class="notice error">{{loadError}}<button class="link" bindtap="onShow">重新读取</button></view>

 <view class="eyebrow">我的</view><view class="page-title">本机简历夹</view><view class="subtitle">写过的经历、喜欢的模板，都留在这台设备。</view>
 <view class="local-card card"><view class="local-card-head"><view class="local-mark"><ui-icon name="folder" size="38"/></view><view class="pill">保存在本机</view></view><view class="local-title">随手写，安心存。</view><view class="local-desc">打开就能继续编辑，资料由你自己保管。</view><button class="outline" bindtap="goResumes">查看我的简历 <ui-icon name="arrow-right" size="28"/></button></view>
 <view class="stats"><view bindtap="goResumes"><view>{{count}}</view><text>本机简历</text></view><view bindtap="favorites"><view>{{favoriteCount}}</view><text>收藏模板</text></view><view bindtap="goTemplates"><view>{{templateCount}}</view><text>模板可选</text></view></view>
 <view class="menu-group card"><view class="menu-row" bindtap="favorites"><view><view class="menu-icon"><ui-icon name="heart" size="34"/></view>我的模板收藏</view><ui-icon name="chevron-right" size="27" color="#9ca798"/></view><view class="menu-row" bindtap="optimize"><view><view class="menu-icon"><ui-icon name="scan" size="34"/></view>给简历做体检</view><ui-icon name="chevron-right" size="27" color="#9ca798"/></view><view class="menu-row" bindtap="storageInfo"><view><view class="menu-icon"><ui-icon name="folder" size="34"/></view>本机保存说明</view><ui-icon name="chevron-right" size="27" color="#9ca798"/></view></view>
 <view class="menu-group card"><view class="menu-row" bindtap="contactAuthor" role="button" aria-label="联系作者"><view><view class="menu-icon"><ui-icon name="wechat" size="34"/></view>联系作者</view><ui-icon name="chevron-right" size="27" color="#9ca798"/></view><view class="menu-row" bindtap="help"><view><view class="menu-icon"><ui-icon name="help" size="34"/></view>使用帮助</view><ui-icon name="chevron-right" size="27" color="#9ca798"/></view><view class="menu-row" bindtap="legal" data-type="privacy"><view><view class="menu-icon"><ui-icon name="shield" size="34"/></view>隐私与数据说明</view><ui-icon name="chevron-right" size="27" color="#9ca798"/></view><view class="menu-row" bindtap="legal" data-type="terms"><view><view class="menu-icon"><ui-icon name="file" size="34"/></view>用户协议</view><ui-icon name="chevron-right" size="27" color="#9ca798"/></view></view>
 <view class="storage-note">换设备或清理微信数据前，<view>记得导出一份重要简历。</view></view>
</view>
