{
  "name": "haojianli-miniprogram",
  "version": "1.0.0",
  "description": "好简历 · 微信原生简历制作与诊断小程序",
  "scripts": {
    "check": "npm run typecheck && npm run build && node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/e2e.js",
    "test:export": "node scripts/native-export.js",
    "build:pdf": "node scripts/build-pdf-parser.js",
    "test:local": "node scripts/native-local.js",
    "test:navigation": "node scripts/native-navigation.js",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck && npm run build",
    "pretest:e2e": "npm run build",
    "pretest:export": "npm run build",
    "pretest:local": "npm run build",
    "pretest:navigation": "npm run build",
    "preview:ui": "npm run build && node scripts/ui-preview.js",
    "format": "prettier --write \"miniprogram/**/*.ts\" scripts/build.js scripts/check.js",
    "format:check": "prettier --check \"miniprogram/**/*.ts\" scripts/build.js scripts/check.js",
    "test:layouts": "node scripts/inspect-layouts.js",
    "pretest:layouts": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "",
  "devDependencies": {
    "@ungap/structured-clone": "^1.3.0",
    "abort-controller": "^3.0.0",
    "esbuild": "^0.25.12",
    "miniprogram-api-typings": "5.2.3",
    "miniprogram-automator": "0.13.0",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "^4.10.38",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "web-streams-polyfill": "^4.2.0"
  }
}
